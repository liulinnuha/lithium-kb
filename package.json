{
  "name": "lithium-kb",
  "version": "1.1.0",
  "description": "Fast, in-memory structured markdown knowledge base (.agent-kb/) with 2D neural graph visualization, live SSE activity stream, and MCP stdio integration.",
  "type": "module",
  "main": "src/core/generator.js",
  "exports": {
    ".": "./src/core/generator.js",
    "./scanner": "./src/core/scanner.js",
    "./server": "./src/server/http.js",
    "./mcp": "./src/mcp/server.js"
  },
  "bin": {
    "lithium-kb": "./bin/agent-kb.js",
    "agent-kb": "./bin/agent-kb.js"
  },
  "scripts": {
    "start": "node bin/agent-kb.js --ui",
    "generate": "node bin/agent-kb.js",
    "watch": "node bin/agent-kb.js --watch",
    "mcp": "node bin/agent-kb.js --mcp",
    "test": "node --test"
  },
  "keywords": [
    "agent-kb",
    "lithium-kb",
    "ai-agent",
    "context-window",
    "neural-graph",
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "pi",
    "knowledge-base",
    "token-optimization"
  ],
  "author": "liulinnuha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liulinnuha/lithium-kb.git"
  },
  "bugs": {
    "url": "https://github.com/liulinnuha/lithium-kb/issues"
  },
  "homepage": "https://github.com/liulinnuha/lithium-kb#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {}
}
